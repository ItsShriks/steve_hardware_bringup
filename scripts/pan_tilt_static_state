#!/usr/bin/env python3
"""
pan_tilt_static_state — joint states for the pan-tilt tower while its motors are off.

The tower is always part of the robot description (TF, RViz, MoveIt and the WBC must see it as
an obstacle), but with enable_pan_tilt:=false nothing publishes its two joints: TF then lacks the
tower links and MoveIt reports an incomplete robot state. This node publishes them at fixed
angles (default 0 = the tower's rest pose) on /joint_states. Started by hardware_bringup.launch.py
instead of the pan-tilt controller.

    ros2 run steve_hardware_bringup pan_tilt_static_state --ros-args -p pan:=0.0 -p tilt:=0.0
"""

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState

JOINTS = ("pan_tilt_pan_motor_joint", "pan_tilt_tilt_motor_joint")


class PanTiltStaticState(Node):
    def __init__(self):
        super().__init__("pan_tilt_static_state")
        self.q = [float(self.declare_parameter("pan", 0.0).value),
                  float(self.declare_parameter("tilt", 0.0).value)]
        rate = float(self.declare_parameter("rate", 10.0).value)
        self.pub = self.create_publisher(JointState, "/joint_states", 10)
        self.create_timer(1.0 / rate, self._tick)
        self.get_logger().info(f"pan-tilt motors off: publishing {JOINTS} = {self.q} rad")

    def _tick(self):
        m = JointState()
        m.header.stamp = self.get_clock().now().to_msg()
        m.name, m.position = list(JOINTS), list(self.q)
        m.velocity, m.effort = [0.0, 0.0], [0.0, 0.0]
        self.pub.publish(m)


def main():
    rclpy.init()
    n = PanTiltStaticState()
    try:
        rclpy.spin(n)
    except KeyboardInterrupt:
        pass
    finally:
        n.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
