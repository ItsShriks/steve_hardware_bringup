#!/usr/bin/env python3
"""
arm_velocity_watchdog — the only publisher to the UR5e's forward_velocity_controller.

A velocity controller keeps executing the last command it received, so a controller that
crashes mid-motion would leave the arm moving. Motion scripts (steve_wbc, --arm_interface
velocity) therefore publish to /arm_velocity_cmd; this node forwards each command (clamped to
max_vel) and publishes ZERO as soon as no command has arrived for `timeout` seconds. It also
publishes zero continuously while idle and once at start-up, so the controller always starts
from standstill. Started (and respawned) by hardware_bringup.launch.py.

    in : /arm_velocity_cmd                      std_msgs/Float64MultiArray, 6 joint velocities [rad/s]
    out: /forward_velocity_controller/commands  std_msgs/Float64MultiArray
"""

import time

import rclpy
from rclpy.node import Node
from std_msgs.msg import Float64MultiArray


class ArmVelocityWatchdog(Node):
    def __init__(self):
        super().__init__("arm_velocity_watchdog")
        self.timeout = self.declare_parameter("timeout", 0.1).value            # [s]
        self.max_vel = self.declare_parameter("max_vel", 1.0).value            # [rad/s]
        self.n = self.declare_parameter("num_joints", 6).value
        rate = self.declare_parameter("rate", 100.0).value                     # [Hz]
        in_topic = self.declare_parameter("input_topic", "/arm_velocity_cmd").value
        out_topic = self.declare_parameter(
            "output_topic", "/forward_velocity_controller/commands").value

        self.pub = self.create_publisher(Float64MultiArray, out_topic, 10)
        self.create_subscription(Float64MultiArray, in_topic, self._cmd_cb, 10)
        self.last_cmd_time = 0.0
        self.moving = False
        self._publish([0.0] * self.n)
        self.create_timer(1.0 / rate, self._tick)
        self.get_logger().info(f"{in_topic} -> {out_topic}: zero after {self.timeout:.2f} s "
                               f"without input, |v| <= {self.max_vel:.2f} rad/s")

    def _publish(self, v):
        self.pub.publish(Float64MultiArray(data=[float(x) for x in v]))

    def _cmd_cb(self, msg):
        if len(msg.data) != self.n:
            self.get_logger().error(f"expected {self.n} velocities, got {len(msg.data)} — ignored",
                                    throttle_duration_sec=2.0)
            return
        v = [max(-self.max_vel, min(self.max_vel, x)) for x in msg.data]
        self.last_cmd_time = time.monotonic()
        self.moving = any(abs(x) > 1e-9 for x in v)
        self._publish(v)

    def _tick(self):
        if time.monotonic() - self.last_cmd_time > self.timeout:
            if self.moving:
                self.get_logger().warn("arm velocity input stopped -> zero velocity")
                self.moving = False
            self._publish([0.0] * self.n)


def main():
    rclpy.init()
    node = ArmVelocityWatchdog()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
