<!-- ROS 2 with Steve over Wi-Fi from this PC (multicast is blocked on the Wi-Fi).
     export ROS_DOMAIN_ID=69 RMW_IMPLEMENTATION=rmw_fastrtps_cpp FASTRTPS_DEFAULT_PROFILES_FILE=~/.ros/fastdds_steve.xml
     Discovery: unicast to the robot (10.7.4.213); one locator per robot participant
     (port 7400 + 250*69 + 10 + 2*id, id 0..119), and to 127.0.0.1 (this PC's own nodes, id 0..29).
     UDP datagrams <= 1400 bytes (no IP fragments); 16 MB shared memory for images on this PC. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>pc_shm</transport_id>
      <type>SHM</type>
      <!-- large enough for camera images between nodes on this PC (default segment is smaller) -->
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>pc_udp</transport_id>
      <type>UDPv4</type>
      <maxMessageSize>1400</maxMessageSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="steve_unicast" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>pc_shm</transport_id>
        <transport_id>pc_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <!-- this PC: its own nodes (camera driver, RViz, WBC) must find each other too (no multicast) -->
